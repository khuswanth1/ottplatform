# ---- core ----
ENV=development                       # development | production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=ott
DATABASE_URL=postgresql+psycopg://postgres:change-me-to-a-long-random-value@localhost:5432/ott
REDIS_URL=                            # optional (leave blank for free/local: in-process cache is used)

# ---- web security ----
CORS_ORIGINS=http://localhost:5173    # comma-separated exact origins (no wildcards)
FRONTEND_URL=http://localhost:5173    # used in verification / reset emails
COOKIE_SECURE=                        # blank = true in production; set false only for plain-http local dev
COOKIE_DOMAIN=
TRUST_PROXY=false                     # true only behind a proxy that overwrites X-Forwarded-For
COUNTRY_HEADER=                       # e.g. CF-IPCountry (set by your CDN). Used to enforce territory rights.
DEFAULT_COUNTRY=US                    # fallback when no trusted country header exists (dev only!)
REQUIRE_EMAIL_VERIFICATION=true
ENABLE_DOCS=true                      # serves /api/v1/docs (disable if you prefer)
METRICS_TOKEN=                        # set to expose /metrics with "Authorization: Bearer <token>"

# ---- email (SMTP). Without it, dev mode logs the links to the server log ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CineVerse <no-reply@example.com>

# ---- billing (optional; use Stripe TEST keys until launch) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- billing: Razorpay (optional; TEST keys until launch; recurring AutoPay subscriptions in INR) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=              # same secret as Razorpay Dashboard > Webhooks (URL: /api/v1/billing/razorpay/webhook)

# ---- providers (get your own keys; none are bundled) ----
TMDB_READ_TOKEN=                      # https://www.themoviedb.org/settings/api  ("API Read Access Token")
TMDB_API_KEY=                         # alternative to the read token (v3 key)
WATCHMODE_API_KEY=                    # https://api.watchmode.com/
YOUTUBE_API_KEY=                      # YouTube Data API v3 key from your own Google Cloud project (console.cloud.google.com > APIs > YouTube Data API v3)
DEMO_SAMPLE_VIDEO=false               # development only: plays a public sample video for titles with no stream
ARCHIVE_ENABLED=true                  # Internet Archive candidate search (admin only)
EXTRA_PROVIDERS=                      # comma-separated "package.module:ClassName" adapters

# ---- cache TTL seconds (stay within each provider's terms) ----
TTL_LISTS=3600
TTL_DETAILS=86400
TTL_SEARCH=900
TTL_AVAILABILITY=43200
STALE_GRACE=86400

# ---- playback ----
EMBED_ALLOWED_HOSTS=archive.org,www.youtube-nocookie.com
CDN_SIGNING_SECRET=                   # enables HMAC-signed URLs for assets flagged requires_signing
CDN_SIGNING_TTL_S=3600
PLAYBACK_SESSION_MINUTES=240
